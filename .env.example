# StudyAgent Environment Variables
# Copy to .env and fill in your values

# LLM Provider (openai | anthropic | ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=

# Database (SQLite for local mode)
DATABASE_URL=sqlite+aiosqlite:///./studyagent.db

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ePay (易支付)
EPAY_ENABLED=false
EPAY_PID=
EPAY_KEY=
EPAY_GATEWAY_URL=https://epay.example.com
EPAY_NOTIFY_URL=http://localhost:8000/api/payment/notify
EPAY_RETURN_URL=http://localhost:3000/payment/result
